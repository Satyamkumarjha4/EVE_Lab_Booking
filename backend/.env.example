DEBUG=True
# Dev-only placeholders. Replace both secrets with long random values outside local development,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
SECRET_KEY=dev-only-insecure-secret-key-replace-before-any-real-deployment
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Must match the `db` service in docker-compose.yml (which defaults to eve/eve/eve).
POSTGRES_DB=eve
POSTGRES_USER=eve
POSTGRES_PASSWORD=eve
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

CORS_ALLOWED_ORIGINS=http://localhost:3000

WEBHOOK_SECRET=dev-only-webhook-signing-secret-replace-me
INTERNAL_BASE_URL=http://web:8000
